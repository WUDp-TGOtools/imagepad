{
  "manifest_version": 3,
  "name": "ImagePad",
  "short_name": "ImagePad",
  "description": "Prepare images beside any page: crop to free areas or site frames, blur, pixelate, cover, watermark. Drag, copy or save. Nothing is uploaded. Part of WUDp by TGO.tools.",
  "author": "TGO (The Giant Octopus)",
  "homepage_url": "https://github.com/WUDp-TGOtools",
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "ImagePad",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "imagepad@tgo.tools",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "sidebar_action": {
    "default_title": "ImagePad",
    "default_panel": "editor/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "version": "1.2.4"
}
