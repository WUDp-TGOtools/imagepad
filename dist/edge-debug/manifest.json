{
  "manifest_version": 3,
  "name": "ImagePad (Debug)",
  "short_name": "ImagePad Debug",
  "description": "[DEBUG BUILD, verbose logs] Prepare images beside any page: crop to free areas or site frames, blur, pixelate, cover, watermark. Drag, copy or save. Nothing is uploaded. Part of WUDp by TGO.tools.",
  "author": "TGO (The Giant Octopus)",
  "homepage_url": "https://github.com/WUDp-TGOtools",
  "permissions": [
    "contextMenus",
    "storage",
    "sidePanel"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "ImagePad",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "editor/index.html"
  },
  "version": "1.2.4"
}
