{
  "name": "imagepad",
  "version": "1.2.5",
  "private": true,
  "type": "module",
  "description": "ImagePad: prepare images for upload, locally in the browser. Part of WUDp by TGO.tools.",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs chrome",
    "build:firefox": "node scripts/build.mjs firefox",
    "build:edge": "node scripts/build.mjs edge",
    "ci": "npm test && npm run check && npm run build",
    "build:debug": "node scripts/build.mjs --debug",
    "build:debug:firefox": "node scripts/build.mjs firefox --debug",
    "build:debug:chrome": "node scripts/build.mjs chrome --debug",
    "build:debug:edge": "node scripts/build.mjs edge --debug"
  },
  "engines": {
    "node": ">=20"
  }
}
